{
    "name": "discordbot",
    "version": "0.3.0-beta.1",
    "description": "Production-ready Discord bot built with TypeScript and Discord.js.",
    "private": true,
    "type": "module",
    "license": "MIT",
    "author": "Meraj",
    "main": "dist/index.js",
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "deploy": "tsx src/deploy.ts",
        "debug": "tsx src/debug.ts",
        "clean": "rimraf dist",
        "rebuild": "npm run clean && npm run build",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "test": "vitest"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Meraj-erj/DiscordBot.git"
    },
    "bugs": {
        "url": "https://github.com/Meraj-erj/DiscordBot/issues"
    },
    "homepage": "https://github.com/Meraj-erj/DiscordBot",
    "keywords": [
        "discord",
        "discord-bot",
        "discord-js",
        "typescript",
        "nodejs",
        "bot"
    ],
    "dependencies": {
        "chalk": "^5.6.2",
        "discord.js": "^14.27.0",
        "dotenv": "^17.4.2",
        "global-agent": "^3.0.0",
        "socks": "^2.8.3",
        "socks-proxy-agent": "^8.0.4",
        "systeminformation": "^5.32.0",
        "undici": "^6.27.0",
        "winston": "^3.19.0",
        "winston-daily-rotate-file": "^5.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/dotenv": "^6.1.1",
        "@types/global-agent": "^3.0.0",
        "@types/node": "^26.1.1",
        "@types/winston": "^2.4.4",
        "eslint": "^10.7.0",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.9.5",
        "rimraf": "^6.1.3",
        "tsx": "^4.23.1",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.64.0",
        "vitest": "^4.1.10"
    },
    "allowScripts": {
        "esbuild@0.28.1": true
    }
}
